# Copy to .env and fill in. The app binds 127.0.0.1 only, so PORT is the only network setting.
# There is no host, broadcast, port, or per-device override setting: wakeonlan sends the magic
# packet to the directed-subnet broadcast through the host's normal route.

# Port bound on loopback. Integer 1-65535.
PORT=7123

# Exact origin the browser must send for every mutation. This is a CSRF check, not authentication.
# Development default is http://localhost:5173. For deployment, set it to the exact HTTPS origin
# reported by `tailscale serve status`. HTTP origins are accepted only for a literal loopback host
# in development/test; production requires HTTPS.
APP_ORIGIN=https://<hostname-placeholder>.ts.net

# SQLite file. The parent directory is created on startup; the path must be writable by the
# service user. In Docker this is the mounted volume: /data/wol.sqlite.
DATABASE_PATH=./data/wol.sqlite

# development | production | test. Production requires APP_ORIGIN and a built UI (dist/).
NODE_ENV=production
