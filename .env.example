# Example configuration only. These are documentation placeholders, not a ready
# to run configuration: every value below must be replaced with the operator's
# own approved settings before the app can run. No value here is a real machine,
# subnet, host, or path on this system.
#
# Bun loads `.env` from the process working directory, so a real `.env` here is
# read by `bun run start`. For a service, prefer an EnvironmentFile outside the
# served root (see docs/wol-poc.service).

# Loopback-only backend. The app is reached through the existing private HTTPS
# proxy; it never binds a non-loopback address.
HOST=127.0.0.1
PORT=3000

# Required: the single origin-only HTTPS URL the browser uses. Production
# rejects an HTTP origin; loopback HTTP is accepted only for an explicit
# development/test configuration. Placeholder domain only: ".invalid" is a
# reserved documentation domain and never resolves.
APP_ORIGIN=https://app.example.invalid

# Required: the operator-supplied IPv4 broadcast address for the working subnet.
# It is validated syntactically only, and subnets are never inferred. The value
# below is from the RFC 5737 documentation range and proves nothing about reach.
WOL_BROADCAST_ADDRESS=192.0.2.255

# Persistent database location, outside the served build output. Placeholder
# path only; the app does not create or verify this directory for you.
DATABASE_PATH=/var/lib/wol-poc/wol-poc.sqlite
