# Example configuration only. Every value below must be replaced with the
# operator's own approved settings before the app can run, and nothing here has
# been checked against a real machine or network.
#
# Bun loads `.env` from the process working directory, so a real `.env` here is
# read by `bun run start`. For a service, prefer an EnvironmentFile outside the
# served root (see docs/wol-poc.service).

# Loopback-only backend. The app is reached through the existing private HTTPS
# proxy; it never binds a non-loopback address and does not terminate TLS.
HOST=127.0.0.1
PORT=7123

# Required: the single origin-only HTTPS URL the browser uses, and the only value
# here that cannot be used as written. Production rejects an HTTP origin; loopback
# HTTP is accepted only for an explicit development/test configuration. Replace the
# placeholder with the hostname the private HTTPS proxy serves on port 7124, the
# port the proxy forwards to the loopback backend above.
APP_ORIGIN=https://<hostname-placeholder>:7124

# Persistent database location, outside the served build output. The app creates
# the parent directory when the store is opened; a service should use a path owned
# by the service user.
DATABASE_PATH=./data/wol.sqlite

# There is no broadcast setting. A device with no saved override is sent with the
# installed wakeonlan CLI's own default; a saved per-device override is used for
# that device alone. A WOL_BROADCAST_ADDRESS left in an old environment file is
# not read, so it cannot affect a command. Existing stored device overrides remain
# effective; a wrong override is cleared by blanking the Broadcast override field
# in the Edit form and saving.
