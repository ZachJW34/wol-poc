# Example unit file only. This project does not install, enable, start, or change
# any service; every name and path below is a placeholder for the operator to
# replace with approved values.
#
# Prerequisites the operator owns:
#   - the build output exists at WorkingDirectory/dist (run `bun run build`),
#   - the installed `wakeonlan` CLI is reachable through the PATH below,
#   - the environment file holds real values (see .env.example),
#   - the data directory is persistent, writable by the service user, and outside
#     the served static root.

[Unit]
Description=WoL web app (loopback backend behind the existing private HTTPS proxy)
After=network.target

[Service]
Type=simple

# Unprivileged service user. Do not run the app as root.
User=wol-app-placeholder
Group=wol-app-placeholder

# Explicit working directory: the static root is resolved as
# <WorkingDirectory>/dist, and a relative DATABASE_PATH resolves from here.
WorkingDirectory=/srv/wol-poc-placeholder

# Real configuration lives outside the served root.
EnvironmentFile=/etc/wol-poc-placeholder/wol-poc.env

# PATH must contain the installed wake CLI. Startup inspects PATH only and never
# executes the executable during the availability check.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStart=/usr/bin/bun-placeholder run start

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
